---
import '../styles/global.css';
const contact = 'https://rptclinic.com/contact';
const booking = 'https://rptclinic.com/booking/';
const phone = 'tel:+12482509387';
const clinicHome = 'https://rptclinic.com/';
const privacy = 'https://rptclinic.com/wp-content/uploads/2025/07/Privacy-Notice-RPT.docx.pdf';
const directions = 'https://maps.app.goo.gl/PyPstKVq9KW7SBoN9';
const googleReviews = 'https://www.google.com/maps/place/Robotic+Precision+Therapy+Clinic/@42.5624451,-83.1937707,17.25z/data=!3m1!5s0x8824c63cc17b5399:0x9e0d2ccd181392f4!4m6!3m5!1s0x8824c39c849cae1d:0xe165db13c65868d4!8m2!3d42.5622418!4d-83.1938685!16s%2Fg%2F11cmysk7r0';
const mapEmbed = 'https://www.google.com/maps?q=Robotic+Precision+Therapy+Clinic,+3250+W+Big+Beaver+Rd+Suite+426,+Troy,+MI+48084&output=embed';
const conditions = [
  { name: 'Sciatica', detail: 'Targeted therapy for pain that radiates through the hip and leg.', href: 'https://rptclinic.com/sciatica/', number: '01' },
  { name: 'Lower back pain', detail: 'Explore a clinician-guided approach to muscular imbalance and back pain.', href: 'https://rptclinic.com/backpain/', number: '02' },
  { name: 'Herniated disc', detail: 'Learn how RPT Clinic approaches disc-related pain and mobility.', href: 'https://rptclinic.com/herniated-disc/', number: '03' },
  { name: 'Neck pain', detail: 'See how precise therapy can address tension and restricted movement.', href: 'https://rptclinic.com/neck-pain/', number: '04' },
  { name: 'Knee pain', detail: 'Understand how hip and quad imbalances can affect the knee.', href: 'https://rptclinic.com/knee-pain/', number: '05' },
  { name: 'Shoulder pain', detail: 'Explore care for tightness, imbalance, and limited shoulder movement.', href: 'https://rptclinic.com/shoulder-pain/', number: '06' },
];
const tickerConditions = [
  'Sciatica', 'Back pain', 'Neck pain', 'Knee pain', 'Shoulder pain', 'Herniated disc',
  'Bulging disc', 'Hip pain', 'Carpal tunnel', 'Plantar fasciitis', 'Piriformis pain',
  'Migraines', 'TMJ pain', 'Scoliosis', 'Spinal stenosis', 'Fibromyalgia', 'Bunions',
  'Shin splints', 'Sports injuries', 'Sports performance', "Golfer's elbow", "Tennis elbow",
  "Runner's knee", 'Ankle pain', 'Poor posture', 'Improved mobility', 'Golf swing',
  'Foot pain', 'Muscle tension', 'Chronic pain', 'Movement limitations', 'Joint stress',
];
const testimonials = [
  { quote: 'Ben and his staff were able to give me substantial relief after I had tried pills, epidurals, acupuncture, meditation, yoga and more.', name: 'Robert S.', detail: 'Verified Google review' },
  { quote: 'Many thanks to Ben and team for the immediate pain relief. They care about their patients!', name: 'Caden C.', detail: 'Verified Google review' },
  { quote: 'Ben and Mike were absolutely spectacular. Super knowledgeable and helped heal my herniated disc.', name: 'Tim T.', detail: 'Verified Google review' },
];
const patientVideos = [
  { name: 'Tony', location: 'Troy', src: 'https://player.vimeo.com/video/1069712620?h=56c6acb635' },
  { name: 'Michael', location: 'Troy', src: 'https://player.vimeo.com/video/1069712590?h=a0bef47922' },
  { name: 'Kim', location: 'Troy', src: 'https://player.vimeo.com/video/1069712559?h=92c2202e79' },
];
const methodVideos = [
  { title: 'See how RPT works', detail: 'A clear look at the clinician-guided method and the RX2600 Therapeutic Robot.', src: 'https://player.vimeo.com/video/1065589415?h=01eee1e845' },
  { title: 'What to expect from treatment', detail: 'Understand the process, from assessment through targeted treatment.', src: 'https://player.vimeo.com/video/1065584846?h=ee5816aa48' },
  { title: 'How RPT compares with other options', detail: 'Dr. Colin Elkins explains the thinking behind a more precise approach.', src: 'https://player.vimeo.com/video/1065585085?h=92663c0de4' },
];
const mediaVideos = [
  { outlet: 'FOX 2 Detroit', title: 'Robotic Precision Therapy on the morning show', href: 'https://www.youtube.com/watch?v=60EuoVb8ekg' },
  { outlet: 'ABC Detroit', title: 'Advanced pain relief technology in Metro Detroit', href: 'https://www.youtube.com/watch?v=CYvqk5u6xeE' },
  { outlet: 'WMYD TV 20', title: 'Breakthrough therapy for chronic pain', href: 'https://www.youtube.com/watch?v=gPAx-iMBO7w' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#a9dcff" />
    <meta name="description" content="Looking for relief from sciatica, back pain, neck pain, or knee pain near Detroit? Learn how clinician-guided Robotic Precision Therapy works at RPT Clinic in Troy, Michigan." />
    <meta property="og:site_name" content="Robotic Muscle Therapy" />
    <meta property="og:title" content="Treat Sciatica, Back & Knee Pain | Robotic Muscle Therapy" />
    <link rel="canonical" href="https://roboticmuscletherapy.com/" />
    <title>Treat Sciatica, Back & Knee Pain | Robotic Muscle Therapy</title>
    <link rel="preconnect" href="https://rptclinic.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body class="overflow-x-hidden">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-white focus:px-4 focus:py-2 focus:text-[#1f3347]">Skip to content</a>
    <header class="site-header fixed inset-x-3 top-3 z-30 mx-auto max-w-[1400px] rounded-lg">
      <nav aria-label="Main navigation" class="mx-auto flex max-w-[1800px] items-center justify-between gap-5 px-5 py-3 lg:px-8">
        <a href="#top" aria-label="Robotic Muscle Therapy home" class="text-xl font-normal tracking-[-.02em] text-[#1f3347] sm:text-2xl">robotic<span class="text-[#008ee6]">muscle</span>therapy</a>
        <div class="hidden items-center gap-8 text-sm font-medium text-[#5b7089] md:flex"><a class="hover:text-[#008ee6]" href="#approach">Our approach</a><a class="hover:text-[#008ee6]" href="#conditions">What we treat</a><a class="hover:text-[#008ee6]" href="#location">Location</a></div>
        <a class="hidden border border-[#008ee6] rounded bg-[#008ee6] px-5 py-3 text-xs font-bold uppercase tracking-wider text-white transition hover:bg-[#0a6fae] sm:inline-flex" href={contact}>Contact RPT Clinic <span aria-hidden="true" class="ml-3">↗</span></a>
        <a class="border border-[#008ee6] px-3 py-2 text-xs font-semibold text-[#008ee6] sm:hidden" href={contact}>Contact ↗</a>
      </nav>
    </header>
    <main id="main">
      <section id="top" class="hero-sky relative overflow-hidden px-6 pb-20 pt-36 lg:px-12 lg:pb-28 lg:pt-44">
        <canvas id="particle-canvas" class="pointer-events-none absolute inset-0 z-[1] h-full w-full opacity-40" aria-hidden="true"></canvas>
        <div class="relative z-10 mx-auto grid w-full max-w-[1500px] items-center gap-14 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,.9fr)]">
          <div><p class="mb-6 text-xs font-medium uppercase tracking-[.28em] text-[#008ee6]">Troy's precision pain clinic</p><h1 class="max-w-4xl text-[clamp(2.8rem,6vw,5.5rem)] font-light leading-[1.02] tracking-[-.03em] text-[#33312e]">Treat <em class="font-light not-italic text-[#008ee6]">sciatica, back &amp; knee pain</em> with precision.</h1><p class="mt-8 max-w-xl text-lg font-light leading-relaxed text-[#425566] sm:text-xl">Discover the advanced, clinician-guided RPT method for persistent pain near Detroit. Robotic Precision Therapy delivers targeted pressure to shortened, imbalanced muscles so your care team can work with greater control and consistency.</p><div class="mt-10 flex flex-wrap gap-3"><a href={booking} class="rounded bg-[#008ee6] px-7 py-4 text-sm font-medium text-white transition hover:bg-[#0a6fae]">Book a free call <span class="ml-3" aria-hidden="true">↗</span></a><a href="#conditions" class="rounded border border-[#008ee6]/40 bg-white/70 px-7 py-4 text-sm font-medium text-[#008ee6] transition hover:border-[#008ee6]">Find your pain topic ↓</a></div><p class="mt-5 text-xs text-[#5b7089]">No meds. No needles. No surgery. <span class="text-[#1f3347]">$150 per treatment hour.</span></p></div>
          <div class="relative"><div class="overflow-hidden rounded-lg border border-[#cfe6f8] bg-white p-3 shadow-[0_30px_80px_-30px_rgba(0,110,190,.45)]"><img src="https://rptclinic.com/wp-content/uploads/2026/01/D020623-8874-scaled.jpg" alt="Clinician-guided robotic therapy at RPT Clinic" class="aspect-[4/3] w-full rounded object-cover" fetchpriority="high" /></div><div class="glass mt-4 rounded-lg p-6 sm:absolute sm:-bottom-8 sm:-left-4 lg:-left-8 sm:mt-0 sm:max-w-xs"><p class="text-xs uppercase tracking-[.26em] text-[#008ee6]">The technology</p><p class="mt-3 text-xl font-normal leading-tight">Human-led care. Robotic precision.</p><p class="mt-3 text-sm font-light leading-relaxed text-[#5b7089]">The RX2600 Therapeutic Robot helps clinicians target shortened, imbalanced muscles with controlled pressure.</p><a href="#approach" class="mt-4 inline-block text-sm font-medium text-[#008ee6] underline decoration-[#008ee6]/40 underline-offset-8">See the approach ↗</a></div></div>
        </div>
      </section>
      <section class="border-y border-[#cfe6f8] bg-[#f2f9ff] px-6 py-7 lg:px-12"><div class="mx-auto flex max-w-[1800px] flex-col gap-6 sm:flex-row sm:items-center sm:justify-between"><div class="flex items-center gap-4"><span class="text-2xl tracking-[.2em] text-[#ffd166]" aria-label="5 out of 5 stars">★★★★★</span><div><p class="font-semibold">4.9 on Google</p><p class="text-xs text-[#5b7089]">93 local reviews in Troy</p></div></div><a href={googleReviews} target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-[#008ee6] underline decoration-[#008ee6]/40 underline-offset-8">Read verified patient reviews ↗</a><a href={phone} class="text-sm font-semibold text-[#5b7089] hover:text-[#008ee6]">Call (248) 250-9387</a></div></section>
      <section id="approach" class="bg-[#f2f9ff] px-6 py-24 text-ink lg:px-12 lg:py-36">
        <div class="mx-auto grid max-w-[1800px] items-center gap-16 lg:grid-cols-2">
          <div class="reveal">
            <p class="text-xs font-medium uppercase tracking-[.25em] text-[#087988]">01 / How RPT works</p>
            <h2 class="mt-8 max-w-2xl text-[clamp(2.2rem,4.2vw,4rem)] font-light leading-[1.05] tracking-[-.03em]">How does robotic precision therapy treat chronic pain?</h2>
            <p class="mt-8 max-w-xl text-lg leading-relaxed text-ink/70">For more than 17 years, RPT clinicians have refined a targeted method for treating the muscular imbalances that can drive pain and restricted movement. Your clinician assesses your full body, identifies shortened or overloaded muscle groups, and uses the FDA Class II registered RX2600 Therapeutic Robot to apply controlled pressure with repeatable precision.</p>
            <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink/70">The result is a focused treatment experience designed to lengthen tight muscles, reduce strain on joints and nerves, and help restore comfortable movement. It is advanced care built around a human clinician, not a machine working alone.</p>
            <a class="mt-9 inline-flex border-b border-ink pb-2 text-sm font-bold uppercase tracking-wider transition hover:text-[#087988]" href={booking}>Book a free call with RPT Clinic ↗</a>
          </div>
          <div class="reveal relative min-h-[430px] lg:min-h-[640px]"><img loading="lazy" src="https://rptclinic.com/wp-content/uploads/2025/12/rpt-process-3-scaled.jpg" alt="Clinician using the RX2600 Therapeutic Robot during treatment" class="absolute inset-0 h-full w-full object-cover" /><div class="glass absolute bottom-5 left-5 right-5 p-5 text-[#1f3347] sm:bottom-8 sm:left-8 sm:right-auto sm:max-w-xs sm:p-7"><p class="text-xs uppercase tracking-[.25em] text-[#008ee6]">Precision meets purpose</p><p class="mt-3 text-lg leading-snug">Targeted, repeatable pressure guided by a trained clinician.</p></div></div>
        </div>
      </section>
      <section id="comparison" class="bg-white px-6 py-24 lg:px-12 lg:py-32"><div class="mx-auto max-w-[1800px]"><div class="reveal max-w-4xl"><p class="text-xs font-medium uppercase tracking-[.25em] text-[#008ee6]">02 / Why patients choose RPT</p><h2 class="mt-6 text-[clamp(2.2rem,4.2vw,4rem)] font-light leading-[1.05] tracking-[-.03em]">What makes RPT different from chiropractic, massage, and standard physical therapy?</h2><p class="mt-8 max-w-2xl text-lg leading-relaxed text-[#5b7089]">Many people arrive after trying several paths to pain relief. RPT adds a precise, technology-assisted option: a clinician finds the muscular restriction, then delivers focused pressure directly to the tissues that need attention.</p></div><div class="mt-14 grid gap-px overflow-hidden border border-[#cfe6f8] bg-white/15 md:grid-cols-3"><article class="bg-white rounded-lg p-7 sm:p-9"><p class="text-xs font-bold uppercase tracking-[.2em] text-[#008ee6]">Compared with massage</p><h3 class="mt-5 text-2xl font-semibold">More than temporary relaxation</h3><p class="mt-4 text-sm leading-relaxed text-[#5b7089]">Massage can feel restorative. RPT is structured around assessment and targeted muscular work intended to address the restrictions affecting movement and pain.</p></article><article class="bg-white rounded-lg p-7 sm:p-9"><p class="text-xs font-bold uppercase tracking-[.2em] text-[#008ee6]">Compared with chiropractic care</p><h3 class="mt-5 text-2xl font-semibold">Muscle-focused precision</h3><p class="mt-4 text-sm leading-relaxed text-[#5b7089]">RPT focuses on shortened and imbalanced muscles with controlled robotic pressure, rather than relying on a manual adjustment alone.</p></article><article class="bg-white rounded-lg p-7 sm:p-9"><p class="text-xs font-bold uppercase tracking-[.2em] text-[#008ee6]">Compared with standard PT</p><h3 class="mt-5 text-2xl font-semibold">A faster path to focused care</h3><p class="mt-4 text-sm leading-relaxed text-[#5b7089]">Traditional physical therapy often builds strength and movement over time. RPT adds precise soft-tissue treatment so clinicians can target restrictions before you return to the activities you value.</p></article></div><div class="mt-12 flex flex-wrap items-center justify-between gap-5 border-t border-[#cfe6f8] pt-7"><p class="max-w-2xl text-sm leading-relaxed text-[#5b7089]">No medication. No needles. No surgery. Just a focused, clinician-guided approach built to help you move forward.</p><a href={booking} class="rounded bg-[#008ee6] px-7 py-4 text-sm font-bold text-white transition hover:bg-[#0a6fae]">Book a free call <span class="ml-4" aria-hidden="true">↗</span></a></div></div></section>
      <section id="stories" class="bg-white px-6 py-24 lg:px-12 lg:py-32"><div class="mx-auto max-w-[1800px]"><div class="reveal flex flex-col justify-between gap-8 lg:flex-row lg:items-end"><div><p class="text-xs font-medium uppercase tracking-[.25em] text-[#008ee6]">02 / Patient stories</p><h2 class="mt-6 max-w-5xl text-[clamp(2.2rem,4.2vw,4rem)] font-light leading-[1.05] tracking-[-.03em]">Hear what patients say after finding a better way forward.</h2></div><p class="max-w-md text-base leading-relaxed text-[#5b7089]">Real people. Real treatment experiences. Watch stories from RPT patients in Troy, then book a free call with the clinic.</p></div><div class="mt-14 grid gap-6 lg:grid-cols-[1.35fr_1fr_1fr]"><article class="overflow-hidden border border-[#cfe6f8] bg-white rounded-lg lg:row-span-2"><div class="aspect-video bg-black lg:aspect-[4/3]"><iframe title="Tony's RPT patient story from Troy" src={patientVideos[0].src} loading="lazy" allow="autoplay; fullscreen; picture-in-picture" class="h-full w-full border-0"></iframe></div><div class="p-6 sm:p-8"><div class="flex items-center justify-between gap-4"><div><h3 class="text-2xl font-semibold">Tony's story</h3><p class="mt-1 text-sm text-[#5b7089]">RPT Clinic, Troy</p></div><span class="text-xl tracking-[.12em] text-[#ffd166]">★★★★★</span></div><a href={booking} class="mt-6 inline-flex text-sm font-bold uppercase tracking-wider text-[#008ee6] underline decoration-[#008ee6]/40 underline-offset-8">Book a free call ↗</a></div></article>{patientVideos.slice(1).map((video) => <article class="overflow-hidden border border-[#cfe6f8] bg-white rounded-lg"><div class="aspect-video bg-black"><iframe title={`${video.name}'s RPT patient story from ${video.location}`} src={video.src} loading="lazy" allow="autoplay; fullscreen; picture-in-picture" class="h-full w-full border-0"></iframe></div><div class="flex items-center justify-between gap-4 p-5"><div><h3 class="text-xl font-semibold">{video.name}'s story</h3><p class="mt-1 text-sm text-[#5b7089]">RPT Clinic, {video.location}</p></div><span class="text-lg tracking-[.12em] text-[#ffd166]">★★★★★</span></div></article>)}</div></div></section>
      <section id="conditions" class="gridline px-6 py-24 lg:px-12 lg:py-32"><div class="mx-auto max-w-[1800px]"><div class="reveal flex flex-col justify-between gap-8 lg:flex-row lg:items-end"><div><p class="text-xs font-medium uppercase tracking-[.25em] text-[#008ee6]">03 / Find your starting point</p><h2 class="mt-6 max-w-3xl text-[clamp(2.2rem,4.2vw,4rem)] font-light leading-[1.05] tracking-[-.03em]">The best way to recover from sciatica, back, neck, or knee pain starts with the right treatment.</h2></div><p class="max-w-sm text-base leading-relaxed text-[#5b7089]">Choose the condition that sounds like your experience and follow the link to RPT Clinic's focused treatment information.</p></div><div class="mt-16 grid border-t border-[#cfe6f8] md:grid-cols-2">{conditions.map((item) => <a class="group flex gap-6 border-b border-[#cfe6f8] p-6 transition hover:bg-[#f2f9ff] sm:p-8 lg:p-10" href={item.href} target="_blank" rel="noopener noreferrer"><span class="pt-2 text-xs font-bold text-[#008ee6]">{item.number}</span><div class="min-w-0 flex-1"><h3 class="text-2xl font-semibold tracking-[-.04em] sm:text-3xl">{item.name}</h3><p class="mt-3 max-w-md text-sm leading-relaxed text-[#5b7089]">{item.detail}</p></div><span aria-hidden="true" class="pt-1 text-xl text-[#008ee6] transition group-hover:-translate-y-1 group-hover:translate-x-1">↗</span></a>)}</div></div></section>
      <section id="proof" class="bg-[#f2f9ff] px-6 py-24 text-ink lg:px-12 lg:py-32"><div class="mx-auto max-w-[1800px]"><div class="reveal flex flex-col justify-between gap-8 md:flex-row md:items-end"><div><p class="text-xs font-medium uppercase tracking-[.25em] text-[#087988]">03 / Patient perspective</p><h2 class="mt-6 max-w-3xl text-[clamp(2.2rem,4.2vw,4rem)] font-light leading-[1.05] tracking-[-.03em]">Proof you can <span class="text-[#087988]">feel.</span></h2></div><div class="flex items-center gap-4"><span class="text-2xl tracking-[.16em] text-[#e4ad26]">★★★★★</span><span class="text-sm font-semibold">4.9/5 on Google</span></div></div><div class="testimonial-shell relative mt-14 overflow-hidden"><div id="testimonial-track" class="flex transition-transform duration-500 ease-out">{testimonials.map((item) => <article class="testimonial-slide min-w-full border border-ink/15 bg-white p-7 sm:p-10 lg:p-14"><p class="max-w-4xl text-[clamp(1.5rem,3vw,3.1rem)] font-medium leading-tight tracking-[-.04em]">“{item.quote}”</p><div class="mt-10 flex items-center justify-between gap-5"><div><p class="font-bold">{item.name}</p><p class="mt-1 text-sm text-ink/55">{item.detail}</p></div><span class="text-3xl tracking-[.12em] text-[#e4ad26]">★★★★★</span></div></article>)}</div><div class="mt-5 flex items-center justify-between"><p id="testimonial-status" class="text-xs font-bold uppercase tracking-[.2em] text-ink/50">01 / 03</p><div class="flex gap-2"><button type="button" id="testimonial-prev" aria-label="Previous testimonial" class="border border-ink/25 px-4 py-2 text-xl transition hover:bg-[#008ee6] hover:text-white">←</button><button type="button" id="testimonial-next" aria-label="Next testimonial" class="border border-ink/25 px-4 py-2 text-xl transition hover:bg-[#008ee6] hover:text-white">→</button></div></div></div><a href={googleReviews} target="_blank" rel="noopener noreferrer" class="mt-10 inline-flex border-b border-ink pb-2 text-sm font-bold uppercase tracking-wider hover:text-[#087988]">See more Google reviews ↗</a></div></section>
      <section class="relative overflow-hidden bg-[#a8f2d6] text-ink"><div class="mx-auto grid max-w-[1800px] items-center lg:grid-cols-2"><div class="reveal px-6 py-20 lg:px-12 lg:py-28"><p class="text-xs font-medium uppercase tracking-[.25em] text-[#087988]">05 / Take the next step</p><h2 class="mt-7 max-w-xl text-[clamp(3rem,6vw,6.8rem)] font-light leading-[1.05] tracking-[-.03em]">Looking for the best pain relief near Detroit?</h2><p class="mt-8 max-w-lg text-lg leading-relaxed text-ink/70">Book a free 15-minute call with RPT Clinic in Troy. Speak directly with the team, share what has been limiting you, and find out how the RPT method can help you move forward.</p><div class="mt-10 flex flex-wrap gap-3"><a class="inline-flex rounded bg-[#008ee6] px-7 py-4 text-sm font-bold text-white transition hover:bg-[#0a6fae]" href={booking}>Book a free call <span class="ml-6" aria-hidden="true">↗</span></a><a class="inline-flex border border-ink px-7 py-4 text-sm font-bold text-ink transition hover:bg-white" href={phone}>Call the clinic</a></div></div><div class="relative min-h-[480px] lg:h-full"><img src="https://rptclinic.com/wp-content/uploads/2025/10/RPTQuad2-topaz-sharpen-denoise-lighting-color-scaled.webp" loading="lazy" alt="Robotic-assisted soft-tissue therapy session" class="absolute inset-0 h-full w-full object-cover" /></div></div></section>
      <section id="location" class="hero-sky relative overflow-hidden px-6 py-24 lg:px-12 lg:py-36"><div class="relative mx-auto grid max-w-[1800px] gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(420px,620px)] lg:items-center"><div class="reveal"><p class="text-xs font-medium uppercase tracking-[.25em] text-[#008ee6]">05 / Find your local specialist</p><h2 class="mt-7 max-w-4xl text-[clamp(2.2rem,4.6vw,4.4rem)] font-light leading-[1.05] tracking-[-.03em]">Where can I find sciatica and back pain treatment near Detroit?</h2><p class="mt-8 max-w-2xl text-lg leading-relaxed text-[#5b7089]">Visit RPT Clinic at 3250 W. Big Beaver Road, Suite 426, Troy, Michigan 48084. The clinic serves patients across Metro Detroit, Rochester, Birmingham, and Grosse Pointe.</p><div class="mt-8 flex flex-wrap gap-3"><a href={directions} target="_blank" rel="noopener noreferrer" class="inline-flex rounded bg-[#008ee6] px-7 py-4 text-sm font-bold text-white transition hover:bg-[#0a6fae]">Get directions <span aria-hidden="true" class="ml-5">↗</span></a><a href={phone} class="inline-flex border border-[#cfe6f8] px-7 py-4 text-sm font-semibold text-[#1f3347] transition hover:border-[#008ee6] hover:text-[#008ee6]">Call (248) 250-9387</a></div></div><div class="overflow-hidden border border-[#cfe6f8] bg-white p-2 shadow-2xl"><iframe title="Map showing RPT Clinic in Troy, Michigan" src={mapEmbed} loading="lazy" referrerpolicy="no-referrer-when-downgrade" class="h-[360px] w-full border-0 sm:h-[440px]"></iframe></div></div></section>
