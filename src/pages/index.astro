">{patientVideos.map((video) => <article class="overflow-hidden border border-white/15 bg-[#102326]"><div class="aspect-[4/5] bg-black"><iframe title={`${video.name} patient testimonial from ${video.location}`} src={video.src} loading="lazy" allow="autoplay; fullscreen; picture-in-picture" class="h-full w-full border-0"></iframe></div><div class="flex items-center justify-between p-5"><div><h3 class="text-xl font-semibold">{video.name}'s story</h3><p class="mt-1 text-sm text-white/55">RPT Clinic, {video.location}</p></div><span class="text-xl tracking-[.12em] text-[#ffd166]">★★★★★</span></div></article>)}</div><div class="media-panel mt-10 hidden grid gap-6 md:grid-cols-3" data-media-panel="coverage" role="tabpanel" aria-hidden="true">{mediaVideos.map((video) => <article class="overflow-hidden border border-white/15 bg-[#102326]"><div class="aspect-video bg-black"><iframe title={`${video.outlet}: ${video.title}`} src={`${video.href.replace('watch?v=', 'embed/')}?rel=0`} loading="lazy" allow="autoplay; fullscreen; picture-in-picture" class="h-full w-full border-0"></iframe></div><div class="flex items-center justify-between gap-4 p-6"><div><p class="text-xs font-bold uppercase tracking-[.2em] text-mint">{video.outlet}</p><h3 class="mt-3 text-xl font-semibold">{video.title}</h3></div><a href={video.href} target="_blank" rel="noopener noreferrer" aria-label={`Open ${video.outlet} coverage`} class="text-xl text-mint">↗</a></div></article>)}</div></div></section>
