    <footer class="border-t border-[#cfe6f8] bg-[#f2f9ff] px-6 py-14 lg:px-12"><div class="mx-auto grid max-w-[1800px] gap-12 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr]"><div><a class="text-xl font-normal tracking-[-.02em] text-[#1f3347]" href="#top">robotic<span class="text-[#008ee6]">muscle</span>therapy</a><p class="mt-4 max-w-sm text-sm leading-relaxed text-[#5b7089]">An independent information and referral landing page for RPT Clinic. Content is educational and does not replace professional medical advice.</p><a class="mt-6 inline-flex text-sm font-semibold text-[#008ee6] hover:text-[#1f3347]" href={clinicHome} target="_blank" rel="noopener noreferrer">Visit RPTClinic.com ↗</a></div><div><p class="text-xs font-bold uppercase tracking-[.22em] text-[#008ee6]">Pain conditions</p><div class="mt-5 grid gap-3 text-sm text-[#5b7089]"><a href="https://rptclinic.com/sciatica/" target="_blank" rel="noopener noreferrer" class="hover:text-[#008ee6]">Sciatica treatment</a><a href="https://rptclinic.com/backpain/" target="_blank" rel="noopener noreferrer" class="hover:text-[#008ee6]">Back pain treatment</a><a href="https://rptclinic.com/neck-pain/" target="_blank" rel="noopener noreferrer" class="hover:text-[#008ee6]">Neck pain treatment</a><a href="https://rptclinic.com/knee-pain/" target="_blank" rel="noopener noreferrer" class="hover:text-[#008ee6]">Knee pain treatment</a></div></div><div><p class="text-xs font-bold uppercase tracking-[.22em] text-[#008ee6]">RPT Clinic</p><div class="mt-5 grid gap-3 text-sm text-[#5b7089]"><a href={contact} target="_blank" rel="noopener noreferrer" class="hover:text-[#008ee6]">Contact the clinic</a><a href={booking} target="_blank" rel="noopener noreferrer" class="hover:text-[#008ee6]">Book an appointment</a><a href={googleReviews} target="_blank" rel="noopener noreferrer" class="hover:text-[#008ee6]">Google reviews</a><a href={privacy} target="_blank" rel="noopener noreferrer" class="hover:text-[#008ee6]">Privacy policy</a></div></div><div><p class="text-xs font-bold uppercase tracking-[.22em] text-[#008ee6]">Troy location</p><address class="mt-5 not-italic text-sm leading-relaxed text-[#5b7089]">3250 W. Big Beaver Road<br />Suite 426<br />Troy, MI 48084</address><a class="mt-4 block text-sm text-[#5b7089] hover:text-[#008ee6]" href={phone}>(248) 250-9387</a><a class="mt-3 block text-sm font-semibold text-[#008ee6] hover:text-[#1f3347]" href={directions} target="_blank" rel="noopener noreferrer">Get directions ↗</a></div></div><div class="mx-auto mt-14 flex max-w-[1800px] flex-col justify-between gap-3 border-t border-[#cfe6f8] pt-6 text-xs text-[#5b7089] sm:flex-row"><span>© {new Date().getFullYear()} Treat Pain Therapy</span><span>Educational information only. Speak with a qualified care team about your symptoms.</span></div></footer>
    <script>
      import * as THREE from 'three';

      const items = document.querySelectorAll('.reveal');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if ('IntersectionObserver' in window && !reducedMotion) {
        const observer = new IntersectionObserver((entries) => { entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); } }); }, { threshold: 0.12 });
        items.forEach((item) => observer.observe(item));
      } else { items.forEach((item) => item.classList.add('is-visible')); }

      const track = document.querySelector<HTMLElement>('#testimonial-track');
      const status = document.querySelector<HTMLElement>('#testimonial-status');
      const slides = document.querySelectorAll('.testimonial-slide');
      let activeSlide = 0;
      const moveTestimonials = (direction: number) => {
        activeSlide = (activeSlide + direction + slides.length) % slides.length;
        if (track && status) {
          track.style.transform = `translateX(-${activeSlide * 100}%)`;
          status.textContent = `0${activeSlide + 1} / 0${slides.length}`;
        }
      };
      document.querySelector('#testimonial-prev')?.addEventListener('click', () => moveTestimonials(-1));
      document.querySelector('#testimonial-next')?.addEventListener('click', () => moveTestimonials(1));

      const mediaTabs = document.querySelectorAll<HTMLButtonElement>('.media-tab');
      const mediaPanels = document.querySelectorAll<HTMLElement>('.media-panel');
      mediaTabs.forEach((tab) => tab.addEventListener('click', () => {
        const target = tab.dataset.mediaTab;
        mediaTabs.forEach((item) => {
          const active = item === tab;
          item.classList.toggle('is-active', active);
          item.classList.toggle('border-[#008ee6]', active);
          item.classList.toggle('text-[#008ee6]', active);
          item.classList.toggle('border-transparent', !active);
          item.classList.toggle('text-[#5b7089]', !active);
          item.setAttribute('aria-selected', String(active));
        });
        mediaPanels.forEach((panel) => {
          const active = panel.dataset.mediaPanel === target;
          panel.classList.toggle('hidden', !active);
          panel.setAttribute('aria-hidden', String(!active));
        });
      }));

      const canvas = document.querySelector('#particle-canvas');
      if (canvas && !reducedMotion) {
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(55, 1, 0.1, 100);
        camera.position.z = 7;
        const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        const particleCount = 750;
        const positions = new Float32Array(particleCount * 3);
        for (let index = 0; index < particleCount; index += 1) {
          positions[index * 3] = (Math.random() - 0.5) * 13;
          positions[index * 3 + 1] = (Math.random() - 0.5) * 8;
          positions[index * 3 + 2] = (Math.random() - 0.5) * 7;
        }
        const geometry = new THREE.BufferGeometry();
        geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
        const material = new THREE.PointsMaterial({ color: 0x008ee6, size: 0.03, transparent: true, opacity: 0.45 });
        const particles = new THREE.Points(geometry, material);
        scene.add(particles);
        const resize = () => { const bounds = canvas.getBoundingClientRect(); renderer.setSize(bounds.width, bounds.height, false); camera.aspect = bounds.width / bounds.height; camera.updateProjectionMatrix(); };
        window.addEventListener('resize', resize);
        resize();
        const animate = (time: number) => { particles.rotation.y = time * 0.000025; particles.rotation.x = Math.sin(time * 0.00015) * 0.08; renderer.render(scene, camera); requestAnimationFrame(animate); };
        requestAnimationFrame(animate);
      }
    </script>
  </body>
